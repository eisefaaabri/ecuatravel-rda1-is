# URL base del microservicio NestJS de Atracciones (Versioning URI v2).
#
# Desarrollo (recomendado): se define en .env.development
# Vite hace proxy de /api hacia http://localhost:3000 (ver vite.config.js),
# evitando problemas de CORS en el navegador.
VITE_API_URL=/api/v2

# Desarrollo directo contra la API (requiere CORS abierto o FRONTEND_URL):
# VITE_API_URL=http://localhost:3000/api/v2

# Producción (obligatorio): define la URL pública real de tu API en .env.production
# (ese archivo está en .gitignore). Ejemplo:
# VITE_API_URL=https://api.tudominio.com/api/v2
