# Configuración de build para producción (copiar a .env.production y ajustar).
# Este archivo se carga automáticamente por Vite con `npm run build`.

# URL base de la API de Atracciones (sin barra final):
#   - Frontend y API tras el mismo proxy/reverse:  /api/v2
#   - Dominios separados:                          https://api.tudominio.com/api/v2
VITE_API_URL=/api/v2